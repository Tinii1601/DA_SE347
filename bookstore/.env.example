# .env.example – Copy file này thành .env và điền thông tin thực tế của bạn
SECRET_KEY=your-django-secret-key-here
DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Cấu hình Cổng thanh toán PayOS
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"

# Cấu hình OAuth2 (Google & Facebook Login)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"

# Cấu hình tài khoản nhận tiền VietQR tĩnh (Fallback)
VIETQR_BANK_NAME="BIDV"
VIETQR_BANK_BIN="970418"
VIETQR_ACCOUNT_NAME="NGUYEN VAN A"
VIETQR_ACCOUNT_NUMBER="0123456789"
VIETQR_QR_URL="/static/img/vietqr_qr.jpg"

# Cấu hình SMTP gửi Email xác nhận đơn hàng / liên hệ
EMAIL_HOST_USER="your-email@gmail.com"
EMAIL_HOST_PASSWORD="your-google-app-password"

# Cấu hình AI Chatbot (Google Gemini API)
GEMINI_API_KEY="your-gemini-api-key"